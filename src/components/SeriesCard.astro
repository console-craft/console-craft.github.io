---
import type { CollectionEntry } from 'astro:content';

interface Props {
	slug: string;
	title: string;
	posts: CollectionEntry<'blog'>[];
	as?: 'h1' | 'h2';
	titleHref?: string;
}

const { slug, title, posts, as: headingLevel = 'h2', titleHref }: Props = Astro.props;
const Heading = headingLevel;
const orderedPosts = [...posts].sort(
	(a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0),
);
const dateFormatter = new Intl.DateTimeFormat('en', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<section class="series-card" aria-labelledby={`series-${slug}`}>
	<header>
		<div>
			<p>Series</p>
			<Heading id={`series-${slug}`}>
				{titleHref ? <a href={titleHref}>{title}</a> : title}
			</Heading>
		</div>
		<span>
			<strong>{String(orderedPosts.length).padStart(2, '0')}</strong>
			<span>{orderedPosts.length === 1 ? 'part' : 'parts'}</span>
		</span>
	</header>
	<div class="series-parts">
		{orderedPosts.map((post) => {
			const isUpcomingDraftPreview = import.meta.env.DEV && post.data.upcoming && post.data.draft;
			const isLinked = !post.data.upcoming || isUpcomingDraftPreview;

			return isLinked ? (
				<a
					class:list={['series-part', 'series-part-link', { 'series-part-upcoming': post.data.upcoming }]}
					href={`/blog/${post.id}/`}
				>
					<span class="part-number">Part {post.data.series?.order}</span>
					<div>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</div>
					{!post.data.upcoming && post.data.pubDate && (
						<time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
					)}
					{post.data.upcoming
						? <span class="upcoming">Upcoming draft</span>
						: post.data.draft && <span class="draft">Draft</span>}
				</a>
			) : (
				<div class="series-part series-part-upcoming">
					<span class="part-number">Part {post.data.series?.order}</span>
					<div>
						<h3>{post.data.title}</h3>
						<p>{post.data.description}</p>
					</div>
					<span class="upcoming">Upcoming</span>
				</div>
			);
		})}
	</div>
</section>

<style>
	.series-card {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: color-mix(in oklab, var(--paper-strong) 88%, transparent);
		box-shadow: var(--shadow);
		transition: scale 220ms ease, translate 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
		.series-card:hover {
			scale: 1.04;
			translate: 0 -8px;
			border-color: rgba(202, 154, 112, 0.62);
			box-shadow: 0 18px 34px rgba(0, 0, 0, 0.26);
		}
	}

	.series-card > header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.3rem, 4vw, 2.2rem);
		border-bottom: 1px solid var(--line);
	}

	.series-card header p {
		margin: 0 0 0.65rem;
		color: var(--orange);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.series-card :is(h1, h2, h3) {
		margin: 0;
	}

	.series-card :is(h1, h2) {
		color: var(--normal);
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		text-transform: uppercase;
	}

	.series-card :is(h1, h2) a {
		color: inherit;
		text-decoration: none;
	}

	.series-card :is(h1, h2) a:hover {
		color: var(--yellow);
	}

	.series-card h3 {
		color: var(--ink-soft);
		font-size: 1rem;
		line-height: 1.45;
	}

	.series-card header > span {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: color-mix(in oklab, var(--brown) 45%, transparent);
		font-size: clamp(2rem, 7vw, 4.5rem);
	}

	.series-card header > span strong {
		font-size: clamp(2rem, 7vw, 4.5rem);
		font-weight: 800;
		line-height: 1;
	}

	.series-card header > span span {
		font-size: 0.8rem;
		text-transform: uppercase;
	}

	.series-part {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: start;
		padding: 1.25rem clamp(1.3rem, 4vw, 2.2rem);
	}

	.series-part-link {
		text-decoration: none;
		transition: background-color 180ms ease;
	}

	.series-part + .series-part {
		border-top: 1px solid var(--line);
	}

	.series-part-link:hover {
		background: var(--accent-soft);
	}

	.series-part-upcoming {
		background: color-mix(in oklab, var(--background) 65%, transparent);
	}

	.series-part-upcoming h3 {
		color: var(--brown);
	}

	.part-number,
	time,
	.draft,
	.upcoming {
		color: var(--orange);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	time {
		padding: 0.08rem 0.4rem;
		border-radius: 999px;
		background-color: var(--yellow);
		color: #333;
	}

	.series-parts p {
		margin: 0.55rem 0 0;
		color: var(--normal);
		font-size: 0.85rem;
		line-height: 1.65;
	}

	.draft,
	.upcoming {
		padding: 0.08rem 0.4rem;
		border: 1px solid var(--blue);
		border-radius: 999px;
		color: var(--yellow);
	}

	.upcoming {
		color: var(--blue);
	}

	@media (max-width: 720px) {
		.series-part {
			grid-template-columns: 1fr auto;
		}

		.part-number {
			grid-column: 1 / -1;
		}

		.series-part > div {
			grid-column: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.series-card,
		.series-part-link {
			transition: none;
		}
	}
</style>
