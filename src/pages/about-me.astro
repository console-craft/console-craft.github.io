---
import Layout from '../layouts/Layout.astro';

const talks = [
	{
		videoId: 'FlIce1A2y7w',
		title: 'tim.js meetup 109: Escape the permanent-underclass by improving your AI workflow',
		date: '22.07.2026',
		dateTime: '2026-07-22',
		language: 'English',
		topics: [
			'dev workflows', 'token spend', 'product engineering', 'productivity', 'tiling wm',
			'terminals', 'multiplexers', 'worktrees', 'agent harness', 'diff viewers',
			'code editors', 'voice dictation', ],
	},
	{
		videoId: 'OlYgPMApMC0',
		title: "tim.js meetup 105: Terminally Curious: I've put Ghostty into Bun",
		date: '25.03.2026',
		dateTime: '2026-03-25',
		language: 'English',
		topics: [
			'web browser terminal', 'pty', 'single file executable', 'web sockets', 'bun',
			'ghostty', 'prototyping', 'bootstrapping', 'context optimization', 'security',
		],
	},
	{
		videoId: '6S1AuPspTiw',
		title: 'tim.js meetup 25: React tooling',
		date: '17.02.2016',
		dateTime: '2016-02-17',
		language: 'Romanian',
		topics: [
			'eslint', 'jsx', 'es6', 'babel', 'browserify', 'watchify', 'browsersync', 'gulp',
			'grunt', 'webpack', 'react developer tools',
		],
	},
];
---

<Layout
	title="About Me • Console Craft"
	description="About Ovi Ispas, developer and founder of Console Craft"
>
	<section class="about">
		<div class="portrait-card">
			<img src="/images/people/ovi.jpeg" alt="Portrait of Ovi Ispas" loading="lazy" />
		</div>

		<div class="about-copy">
			<h1>Ovi Ispas</h1>
			<p class="lead">I'm a Senior Software Engineer and hands-on Technical Lead with deep experience across modern web development, developer tooling, TypeScript and Python.</p>
			<p>My core expertise is in TypeScript and web engineering, and I’m increasingly applying that experience to AI engineering and Python based backend systems to build AI agents and agent orchestration, workflow automations, LLM integrations and RAG systems.</p>
			<div class="about-actions">
				<a class="action-button github" href="https://github.com/console-craft" target="_blank" rel="noopener noreferrer">Github</a>
				<a class="action-button" href="https://ro.linkedin.com/in/ovi-ispas" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</div>
		</div>
	</section>

	<section class="talks" id="talks" aria-labelledby="talks-heading">
		<h2 id="talks-heading">Talks</h2>
		<div class="talk-list">
			{talks.map((talk) => (
				<article class="talk-card">
					<div class="talk-video">
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${talk.videoId}`}
							title={talk.title}
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
						></iframe>
					</div>
					<div class="talk-details">
						<time datetime={talk.dateTime}>{talk.date}</time>
						<h3>{talk.title}</h3>
						<div class="talk-pills" aria-label={`Language and topics for ${talk.title}`}>
							<span class="pill language">{talk.language}</span>
							{talk.topics.map((topic) => <span class="pill">{topic}</span>)}
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(230px, 320px) minmax(0, 1fr);
		gap: clamp(1.2rem, 4vw, 2.6rem);
		align-items: start;
		margin-top: 2rem;
	}

	.portrait-card {
		border: 1px solid var(--line);
		border-radius: 20px;
		overflow: hidden;
		background: var(--paper-strong);
		box-shadow: var(--shadow);
		animation: fade-up 760ms ease both;
	}

	.portrait-card img {
		display: block;
		width: 100%;
		height: auto;
	}

	.about-copy {
		max-width: 42rem;
	}

	.eyebrow {
		margin: 0;
		font-weight: 800;
		color: var(--green);
	}

	h1 {
		margin: 0.5rem 0 2rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		text-transform: uppercase;
		color: var(--yellow);
	}

	p {
		margin: 0 0 2rem;
		line-height: 1.6em;
		font-size: 0.9rem;
	}


	p.lead {
		line-height: 1.8em;
		color: var(--ink-soft);
		font-size: 1.2rem;
	}

	p strong {
		color: var(--aqua);
    	font-weight: 800;
	}

	.about-actions {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-top: 0.4rem;
	}

	.talks {
		margin-top: clamp(4rem, 9vw, 7rem);
	}

	h2 {
		margin: 0 0 1.5rem;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		text-transform: uppercase;
		color: var(--yellow);
	}

	.talk-list {
		display: grid;
		gap: 4rem;
	}

	.talk-card {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
		gap: clamp(1.2rem, 3vw, 2rem);
		align-items: start;
		min-height: 400px;
		padding: clamp(1rem, 2.5vw, 1.5rem);
		border: 1px solid var(--line);
		border-radius: 20px;
		background: var(--paper-strong);
		box-shadow: var(--shadow);
		transition: scale 220ms ease, translate 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	.talk-card:nth-child(even) .talk-video {
		order: 2;
	}

	.talk-card:nth-child(even) {
		grid-template-columns: minmax(280px, 1fr) minmax(0, 1.5fr);
	}

	@media (hover: hover) and (pointer: fine) {
		.talk-card:hover {
			scale: 1.02;
			translate: 0 -8px;
			border-color: rgba(202, 154, 112, 0.62);
			box-shadow: 0 18px 34px rgba(0, 0, 0, 0.26);
		}
	}

	.talk-video {
		align-self: start;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--background);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.2);
	}

	.talk-video iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.talk-details {
		padding: 0.25rem 0;
	}

	.talk-details time {
		display: block;
		margin-bottom: 0.65rem;
		color: var(--orange);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.talk-details h3 {
		margin: 0 0 1.6rem;
		color: var(--blue);
		font-size: clamp(1.2rem, 2.3vw, 1.5rem);
		line-height: 1.4;
	}

	.talk-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.pill {
		display: inline-flex;
		padding: 0.25rem 0.5rem;
		border: 0;
		border-radius: 999px;
		background: var(--yellow);
		color: var(--background);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.pill.language {
		background: var(--blue);
		color: var(--background);
		font-weight: 800;
	}

	.action-button {
		display: inline-flex;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--accent-soft);
		color: var(--yellow);
		text-decoration: none;
	}

	.action-button.github {
		border-color: var(--blue);
		background-color: var(--blue-soft);
		color: var(--blue);
	}

	@media (max-width: 760px) {
		.about {
			grid-template-columns: 1fr;
		}

		.portrait-card {
			max-width: 340px;
		}

		.talk-card,
		.talk-card:nth-child(even) {
			grid-template-columns: 1fr;
		}

		.talk-card:nth-child(even) .talk-video {
			order: initial;
		}
	}
</style>
