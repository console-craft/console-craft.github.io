---
import Layout from '../layouts/Layout.astro';
import RobotScene from '../components/RobotScene';
---

<Layout title="Console Craft • Independent software playground by Ovi Ispas" description="Independent software playground by Ovi Ispas">
	<section class="hero">
		<div>
			<h1>Console Craft</h1>
			<p class="intro">
				Console Craft is an independent software playground by Ovi Ispas, focused on experiments, demos, and exploring AI-powered apps, developer tools, and emerging technologies.
			</p>
		</div>
		<div class="robot"><RobotScene client:load /></div>
	</section>

	<section class="featured-projects" aria-labelledby="featured-projects-heading">
		<div class="section-header">
			<h2 id="featured-projects-heading">My Latest Projects</h2>
		</div>

		<div class="project-grid">
			<article class="project-card">
				<button
					class="project-image-trigger"
					type="button"
					aria-label="Expand Tech Note Craft screenshot"
					aria-controls="project-lightbox"
					data-lightbox-src="/images/projects/tech-note-craft-project-screenshot.png"
					data-lightbox-alt="Expanded Tech Note Craft technical notes interface screenshot"
				>
					<img
						src="/images/projects/tech-note-craft-project-screenshot.png"
						alt="Tech Note Craft technical notes interface screenshot"
						loading="lazy"
					/>
				</button>
				<div class="project-copy">
					<h3>Tech Note Craft</h3>
					<div class="tech-badges">
						<span class="tech">AI Chat</span>
						<span class="tech">OpenAI SDK</span>
						<span class="tech">Markdown Rendering</span>
						<span class="tech">Component Library</span>
					</div>
					<p>
						Tech Note Craft turns local Markdown files into a browsable technical notes library.<br/><br/>
						It groups notes by topic, renders expandable cards with syntax-highlighted code, and keeps learning workflows fast with quiz support and per-card AI tutor chats.<br/><br/>
						<strong>Features:</strong> Markdown content explorer, light/dark mode, fullscreen reading, adjustable text size, local chat history, and OpenAI-powered study assistance.
					</p>
					<div class="project-buttons">
						<a
							class="project-button github"
							href="https://github.com/console-craft/tech-note-craft"
							target="_blank"
							rel="noopener noreferrer"
						>
							Github
						</a>
						<a
							class="project-button"
							href="https://console-craft.com/tech-note-craft"
							target="_blank"
							rel="noopener noreferrer"
						>
							Website
						</a>
					</div>
				</div>
			</article>

			<article class="project-card project-card-image-right">
				<button
					class="project-image-trigger"
					type="button"
					aria-label="Expand Term Serve screenshot"
					aria-controls="project-lightbox"
					data-lightbox-src="/images/projects/term-serve-project-screenshot.png"
					data-lightbox-alt="Expanded Term Serve user interface screenshot"
				>
					<img
						src="/images/projects/term-serve-project-screenshot.png"
						alt="Term Serve user interface screenshot"
						loading="lazy"
					/>
				</button>
				<div class="project-copy">
					<h3>Term Serve</h3>
					<div class="tech-badges">
						<span class="tech">TypeScript</span>
						<span class="tech">WebSocket</span>
						<span class="tech">Shell</span>
						<span class="tech">CLI</span>
					</div>
					<p>
						Term Serve lets you securely open your terminal in any browser in seconds.<br/><br/> 
						It starts a local server, launches a real shell session, and gives you a clean, responsive UI to use it from your laptop or phone.<br/><br/>
						<strong>Features:</strong> Mobile-friendly controls, custom themes and mono-space fonts, auth token, access logs, and fast single-binary install.
					</p>
					<div class="project-buttons">
						<a
							class="project-button github"
							href="https://github.com/console-craft/term-serve"
							target="_blank"
							rel="noopener noreferrer"
						>
							Github
						</a>
						<a
							class="project-button"
							href="https://console-craft.com/term-serve"
							target="_blank"
							rel="noopener noreferrer"
						>
							Website
						</a>
					</div>
				</div>
			</article>

			<article class="project-card">
				<button
					class="project-image-trigger"
					type="button"
					aria-label="Expand NVIM Neocraft screenshot"
					aria-controls="project-lightbox"
					data-lightbox-src="/images/projects/nvim-neocraft-project-screenshot.png"
					data-lightbox-alt="Expand NVIM Neocraft screenshot"
				>
					<img
						src="/images/projects/nvim-neocraft-project-screenshot.png"
						alt="NVIM Neocraft screenshot"
						loading="lazy"
					/>
				</button>
				<div class="project-copy">
					<h3>NVIM Neocraft</h3>
					<div class="tech-badges">
						<span class="tech">Dev Tools</span>
						<span class="tech">Language Servers</span>
						<span class="tech">IDE</span>
						<span class="tech">Lua</span>
					</div>
					<p>
						NVIM Neocraft is my personal Neovim 0.12+ setup, built around explicit Lua modules, native APIs, and a mini.nvim-first workflow.<br/><br/>
						It combines fast file picking, sessions, completions, Treesitter, project-aware formatting, a floating terminal, and tuned LSP support for TypeScript and Python.<br/><br/>
						<strong>Features:</strong> Mini-powered UI and navigation, OpenCode AI coding agent integration, Copilot inline completions, Diffview integration, Git worktrees, and bisect/rebase/cherry-pick helpers.
					</p>
					<div class="project-buttons">
						<a
							class="project-button github"
							href="https://github.com/console-craft/nvim-neocraft"
							target="_blank"
							rel="noopener noreferrer"
						>
							Github
						</a>
					</div>
				</div>
			</article>

		</div>
	</section>

	<div class="lightbox" id="project-lightbox" aria-hidden="true">
		<div class="lightbox-content">
			<img
				id="project-lightbox-image"
				src="/images/projects/term-serve-project-screenshot.png"
				alt="Expanded Term Serve user interface screenshot"
			/>
		</div>
	</div>
</Layout>

<script is:inline>
	const triggers = document.querySelectorAll('.project-image-trigger');
	const lightbox = document.getElementById('project-lightbox');
	const lightboxImage = document.getElementById('project-lightbox-image');

	if (triggers.length > 0 && lightbox && lightboxImage instanceof HTMLImageElement) {
		const openLightbox = (trigger) => {
			const src = trigger.dataset.lightboxSrc;
			const alt = trigger.dataset.lightboxAlt;

			if (src) {
				lightboxImage.src = src;
			}

			if (alt) {
				lightboxImage.alt = alt;
			}

			lightbox.classList.add('is-open');
			lightbox.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		};

		const closeLightbox = () => {
			lightbox.classList.remove('is-open');
			lightbox.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener('click', () => openLightbox(trigger));
		});

		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) {
				closeLightbox();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && lightbox.classList.contains('is-open')) {
				closeLightbox();
			}
		});
	}
</script>

<style>
	.hero {
		margin-bottom: 3.2rem;
		display: flex;
		gap: 2rem;
	}

	.hero > div:first-child {
		flex: 1;
	}

	.hero > .robot {
		height: 400px;
		width: 400px;
		flex: 0 0 400px;
		overflow: hidden;
	}

	@media (max-width: 840px) {
		.hero {
			flex-direction: column;
			align-items: center;
			gap: 1.5rem;
			margin-bottom: 2.5rem;
		}
	}

	.title-row {
		display: flex;
		justify-content: flex-start;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.title-row img {
		width: clamp(2.3rem, 6vw, 3.5rem);
		height: clamp(2.3rem, 6vw, 3.5rem);
	}

	.eyebrow {
		margin: 0.65rem 0 0;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--aqua);
	}

	h1 {
		margin: 2rem 0 4rem;
		font-size: clamp(2.4rem, 7vw, 4.8rem);
		line-height: 1.05;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--yellow);
	}

	.intro {
		margin: 2rem 0 0;
		max-width: 44rem;
		color: var(--ink-soft);
		line-height: 1.8em;
		font-size: 1.2rem;
	}

	.featured-projects {
		padding-bottom: 0.5rem;
	}

	.project-grid {
		display: grid;
		gap: 4rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		font-weight: 800;
		text-transform: uppercase;
	}

	.section-header a {
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--green);
		text-underline-offset: 0.2em;
		text-transform: uppercase;
		letter-spacing: 0.18em;
	}

	.section-header a span {
		display: inline-block;
		margin-left: 0.25rem;
		text-decoration: none;
	}

	.section-header a:hover {
		color: var(--yellow);
	}

	#featured-projects-heading {
		margin-bottom: 1.5rem;
	}

	.project-card {
		display: grid;
		grid-template-columns: minmax(0, 2.5fr) minmax(0, 1.5fr);
		background: var(--paper-strong);
		border-radius: 20px;
		border: 1px solid var(--line);
		overflow: hidden;
		box-shadow: var(--shadow);
		animation: fade-up 760ms ease both;
		animation-delay: 140ms;
		transition: scale 220ms ease, translate 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.project-card:hover {
			scale: 1.04;
			translate: 0 -8px;
			border-color: rgba(202, 154, 112, 0.62);
			box-shadow: 0 18px 34px rgba(0, 0, 0, 0.26);
		}
	}

	.project-card-image-right {
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 2.5fr);
	}

	.project-card-image-right img {
		border-right: 0;
		border-left: 1px solid var(--line) !important;
	}

	.project-card-image-right .project-image-trigger {
		order: 2;
	}

	.project-image-trigger {
		padding: 0;
		margin: 0;
		border: 0;
		background: none;
		display: block;
		width: 100%;
		height: 100%;
		cursor: zoom-in;
	}

	.project-card img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		min-height: 220px;
		filter: saturate(0.86) contrast(1.03);
		border-right: 1px solid var(--line);
	}

	.lightbox {
		position: fixed;
		inset: 0;
		display: none;
		place-items: center;
		padding: 2rem;
		background: rgba(14, 13, 12, 0.86);
		z-index: 100;
		cursor: zoom-out;
	}

	.lightbox.is-open {
		display: grid;
	}

	.lightbox-content {
		width: min(80vw, 1200px);
		max-height: 80vh;
		cursor: default;
	}

	.lightbox-content img {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 80vh;
		object-fit: contain;
		border: 1px solid var(--line);
		border-radius: 12px;
		box-shadow: 0 24px 40px rgba(0, 0, 0, 0.45);
	}

	.project-copy {
		padding: clamp(1.2rem, 3vw, 1rem);
		display: grid;
		align-content: center;
		gap: 0.7rem;
	}

	h3 {
		margin: 0 0 0.5em;
		font-size: clamp(1.3rem, 2.5vw, 1.5rem);
		color: var(--blue);
		font-weight: 800;
	}

	.project-copy p {
		font-size: 0.75rem;
		margin: 0;
		line-height: 1.7;
		color: var(--normal);
	}

	.project-button {
		margin-top: 1rem;
		display: inline-flex;
		justify-self: start;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--accent-soft);
		color: var(--yellow);
		text-decoration: none;
	}

	.project-button.github {
		border-color: var(--blue);
		background-color: var(--blue-soft);
		color: var(--blue);
	}

 .project-buttons {
		display: flex;
		gap: 10px;
	}

	.tech {
		display: inline-block;
		width: auto;
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		background: var(--yellow);
		color: var(--background);
		font-size: 0.75rem;
		font-weight: 700;
		margin: 0.3rem 0.1rem;
	}

	@media (max-width: 840px) {
		.project-card {
			grid-template-columns: 1fr;
		}

		.project-card-image-right .project-image-trigger {
			order: initial;
		}

		.project-card img {
			max-height: 320px;
		}
	}

	@media (max-width: 640px) {
		.title-row {
			gap: 0.6rem;
		}

		.section-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.35rem;
		}
	}
</style>
