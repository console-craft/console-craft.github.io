---
interface Props {
	title: string;
	description?: string;
	canonical?: string;
	pageType?: 'website' | 'article';
	socialImage?: string;
	publishedDate?: Date;
	updatedDate?: Date;
}

const {
	title,
	description = 'Independent software playground by Ovi Ispas.',
	canonical,
	pageType = 'website',
	socialImage,
	publishedDate,
	updatedDate,
}: Props = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home', matchChildren: false },
	{ href: '/blog', label: 'Blog', matchChildren: true },
	{ href: '/about-me#talks', label: 'Talks', matchChildren: false },
	{ href: '/about-me', label: 'About', matchChildren: false },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const brandLabel = pathname === '/' ? 'Born in the console, evolved to production.' : 'Console Craft';
const year = new Date().getFullYear();
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageUrl = socialImage ? new URL(socialImage, Astro.site ?? Astro.url.origin) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content="Console Craft" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZQHC2SWXSQ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-ZQHC2SWXSQ');
		</script>
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href="/">
					<img src="/logo.svg" alt="Logo" /><span>{brandLabel}</span>
				</a>
				<nav class="site-nav" aria-label="Main">
					{
						navLinks.map((link) => {
							const [linkHref, linkSection] = link.href.split('#');
							const linkPath = linkHref.replace(/\/$/, '') || '/';
							const isActive = !linkSection && (pathname === linkPath
								|| (link.matchChildren && pathname.startsWith(`${linkPath}/`)));

							return (
								<a
									href={link.href}
									class={isActive ? 'active' : undefined}
									aria-current={isActive ? 'page' : undefined}
									data-nav-section={linkSection}
								>
									{link.label}
								</a>
							);
						})
					}
				</nav>
			</header>

			<main class="site-main">
				<slot />
			</main>

			<footer class="site-footer">
				<p>© {year} Console Craft</p>
			</footer>
		</div>

		<button class="back-to-top" type="button" aria-label="Back to top" aria-hidden="true" tabindex="-1">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 20V4m0 0-6 6m6-6 6 6"></path>
			</svg>
		</button>

		<script is:inline>
			const aboutLink = document.querySelector('.site-nav a[href="/about-me"]');
			const talksLink = document.querySelector('.site-nav a[data-nav-section="talks"]');

			if (aboutLink instanceof HTMLAnchorElement && talksLink instanceof HTMLAnchorElement) {
				const updateAboutNavigation = () => {
					const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
					const isAboutPage = currentPath === '/about-me';
					const isAtTop = window.scrollY <= 1;
					const isTalksSection = isAboutPage && !isAtTop && window.location.hash === '#talks';

					aboutLink.classList.toggle('active', isAboutPage && !isTalksSection);
					talksLink.classList.toggle('active', isTalksSection);

					if (isAboutPage && !isTalksSection) aboutLink.setAttribute('aria-current', 'page');
					else aboutLink.removeAttribute('aria-current');

					if (isTalksSection) talksLink.setAttribute('aria-current', 'location');
					else talksLink.removeAttribute('aria-current');
				};

				window.addEventListener('hashchange', updateAboutNavigation);
				window.addEventListener('scroll', updateAboutNavigation, { passive: true });
				updateAboutNavigation();
			}

			const backToTop = document.querySelector('.back-to-top');

			if (backToTop instanceof HTMLButtonElement) {
				const updateBackToTop = () => {
					const isVisible = window.scrollY > 0;
					backToTop.classList.toggle('is-visible', isVisible);
					backToTop.setAttribute('aria-hidden', String(!isVisible));
					backToTop.tabIndex = isVisible ? 0 : -1;
				};

				backToTop.addEventListener('click', () => {
					const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
					window.scrollTo({ top: 0, behavior });
				});
				window.addEventListener('scroll', updateBackToTop, { passive: true });
				updateBackToTop();
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--normal: #d4be98;
		--purple: #d4a599;
		--blue: #adb79d;
		--orange: #eead83;
		--aqua: #b2ba8e;
		--green: #bac584;
		--red: #de9880;
		--yellow: #d6b37b;
		--brown: #ca9a70;
		--background: #33302e;
		--paper: var(--background);
		--paper-strong: #3b3734;
		--ink: var(--normal);
		--ink-normal: var(--ink);
		--ink-soft: var(--blue);
		--line: rgba(202, 154, 112, 0.42);
		--accent: var(--green);
		--accent-soft: rgba(212, 165, 153, 0.16);
		--shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		font-family: 'JetBrains Mono', monospace;
		color: var(--ink);
		background:
			radial-gradient(circle at 12% 0%, color-mix(in oklab, #7daea3 16%, transparent), transparent 40%),
			radial-gradient(circle at 88% 8%, rgba(181, 118, 20, 0.1), transparent 38%),
			#302e2c;
		background-repeat: no-repeat;
		background-size:
			100vw 100vh,
			100vw 100vh,
			auto;
		background-position:
			top left,
			top left,
			top left;
	}

	a {
		color: inherit;
	}

	.site-shell {
		width: min(1040px, 100% - 2.5rem);
		margin: 0 auto;
		padding-bottom: 2.5rem;
	}

	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1.8rem 0 1.25rem;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		text-decoration: none;
	}

    .brand img {
		height: 30px;
    	border-radius: 5px;
    	box-shadow: 0px 0px 0px 1px rgba(255, 255, 255, 0.35) inset;
	}

	.brand span {
		font-size: 0.95rem;
	}

	.site-nav {
		display: inline-flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.site-nav a {
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		border: 1px solid transparent;
		text-decoration: none;
		color: var(--orange);
		transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease;
	}

	.site-nav a:not(.active):hover {
		text-decoration: underline;
	}

	.site-nav a.active {
		background: var(--accent-soft);
		border-color: var(--line);
		color: var(--yellow);
	}

	.site-main {
		padding-top: 2.5rem;
	}

	.site-main > * {
		animation: fade-up 620ms ease both;
	}

	.site-footer {
		padding-top: 2.75rem;
		font-size: 0.9rem;
		color: var(--brown);
	}

	.back-to-top {
		position: fixed;
		right: clamp(1rem, 3vw, 2rem);
		bottom: clamp(1rem, 3vw, 2rem);
		display: grid;
		width: 3rem;
		height: 3rem;
		padding: 0;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--paper-strong);
		color: var(--yellow);
		box-shadow: var(--shadow);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		translate: 0 0.75rem;
		transition: opacity 180ms ease, visibility 180ms ease, translate 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease;
		z-index: 20;
	}

	.back-to-top.is-visible {
		opacity: 1;
		visibility: visible;
		translate: 0;
	}

	.back-to-top svg {
		width: 1.4rem;
		height: 1.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (hover: hover) and (pointer: fine) {
		.back-to-top:hover {
			translate: 0 -4px;
			border-color: var(--yellow);
			background: var(--yellow);
			color: var(--background);
		}
	}

	.back-to-top:focus-visible {
		outline: 2px solid var(--yellow);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.back-to-top {
			transition: none;
		}
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 720px) {
		.site-shell {
			width: min(1040px, 100% - 1.5rem);
		}

		.site-header {
			padding-top: 1.2rem;
			flex-direction: column;
			align-items: flex-start;
		}

		.brand { 
			margin-left: 0.5rem 
		}

		.site-nav {
			margin-top: 1rem;
			width: 100%;
			gap: 0.35rem;
		}

		.site-nav a {
			padding-inline: 0.65rem;
		}

		.site-main {
			padding-top: 1.8rem;
		}
	}
</style>
