---
import type { MarkdownHeading } from 'astro';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import heroImage from '../assets/blog/article-hero.jpg';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/typeset.css';
import Layout from './Layout.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
	seriesPosts: CollectionEntry<'blog'>[];
}

const { post, headings, seriesPosts }: Props = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('en', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const currentIndex = seriesPosts.findIndex(({ id }) => id === post.id);
const previousPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : undefined;
const nextPost = currentIndex >= 0 ? seriesPosts[currentIndex + 1] : undefined;
const seriesHref = `/blog/${post.id.split('/')[0]}/`;
const optimizedHero = await getImage({ src: heroImage, width: 1600, format: 'webp', quality: 80 });
---

<Layout
	title={`${post.data.title} • Console Craft`}
	description={post.data.description}
	canonical={`/blog/${post.id}/`}
	pageType="article"
	socialImage={optimizedHero.src}
	publishedDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
>
	<article class="blog-article">
		<header class="article-hero" style={`--article-hero-image: url("${optimizedHero.src}")`}>
			<div class="article-hero-copy">
				<h1>{post.data.title}</h1>
				<p>{post.data.description}</p>
				<div class="article-meta">
					{post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>}
					{post.data.series && <span>Part {post.data.series.order}</span>}
					{post.data.draft && <span class="draft-badge">Draft</span>}
				</div>
			</div>
		</header>

		<TableOfContents headings={headings} mobile />

		{!post.data.series && (
			<nav class="standalone-navigation top" aria-label="Blog navigation before article">
				<a href="/blog">← Blog Index</a>
			</nav>
		)}

		{
			post.data.series && seriesPosts.length > 1 && (
				<nav class="series-navigation top" aria-label={`${post.data.series.title} series navigation`}>
					<p class="series-breadcrumb">
						<a href="/blog">Blog</a>
						<span aria-hidden="true">&gt;</span>
						<a href={seriesHref} class="series-title">{post.data.series.title}</a>
						<span>(Series)</span>
					</p>
				</nav>
			)
		}

		<div class="article-layout">
			<div class="article-body typeset typeset-article">
				<slot />
			</div>
			<TableOfContents headings={headings} />
		</div>

		{!post.data.series && (
			<nav class="standalone-navigation" aria-label="Blog navigation after article">
				<a href="/blog">← Blog Index</a>
			</nav>
		)}

		{
			post.data.series && seriesPosts.length > 1 && (
				<nav class="series-navigation" aria-label={`${post.data.series.title} series navigation`}>
					<p class="series-breadcrumb">
						<a href="/blog">Blog</a>
						<span aria-hidden="true">&gt;</span>
						<a href={seriesHref} class="series-title">{post.data.series.title}</a>
						<span>(Series)</span>
					</p>
					<div>
						{previousPost ? (
							<a href={`/blog/${previousPost.id}/`} rel="prev">
								<span>← Previous Article</span>
								<strong>{previousPost.data.title}</strong>
							</a>
						) : <span />}
						{nextPost && (
							<a class="next" href={`/blog/${nextPost.id}/`} rel="next">
								<span>Next Article →</span>
								<strong>{nextPost.data.title}</strong>
							</a>
						)}
					</div>
				</nav>
			)
		}
	</article>

	<script is:inline>
		document.querySelectorAll('.article-body a[href^="http://"], .article-body a[href^="https://"]').forEach((link) => {
			link.setAttribute('target', '_blank');
			link.setAttribute('rel', 'noopener noreferrer');
		});

		const articleHeadings = [...document.querySelectorAll('.article-body :is(h2, h3)[id]')];
		const contentMapLinks = [...document.querySelectorAll('.content-map a[href^="#"]')];

		if (articleHeadings.length > 0 && contentMapLinks.length > 0) {
			let contentMapFrame = 0;

			const updateActiveContentItem = () => {
				let activeHeading = articleHeadings[0];

				for (const heading of articleHeadings) {
					if (heading.getBoundingClientRect().top > 140) break;
					activeHeading = heading;
				}

				for (const link of contentMapLinks) {
					const isActive = link.getAttribute('href') === `#${activeHeading.id}`;
					link.classList.toggle('active', isActive);
					link.parentElement?.classList.toggle('active', isActive);

					if (isActive) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				}
			};

			const requestContentMapUpdate = () => {
				if (contentMapFrame) return;
				contentMapFrame = requestAnimationFrame(() => {
					contentMapFrame = 0;
					updateActiveContentItem();
				});
			};

			window.addEventListener('scroll', requestContentMapUpdate, { passive: true });
			window.addEventListener('resize', requestContentMapUpdate);
			window.addEventListener('hashchange', requestContentMapUpdate);
			window.addEventListener('load', requestContentMapUpdate);
			updateActiveContentItem();
		}
	</script>
</Layout>

<style is:global>
	.blog-article {
		--blog-reading-width: 43rem;
	}

	.article-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: clamp(21rem, 44vw, 29rem);
		display: flex;
		align-items: flex-end;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		border: 1px solid var(--line);
		border-radius: 20px;
		background:
			linear-gradient(0deg, rgba(41, 39, 37, 0.96), rgba(41, 39, 37, 0.2) 78%),
			linear-gradient(90deg, rgba(41, 39, 37, 0.78), rgba(41, 39, 37, 0.06) 76%),
			var(--article-hero-image) center / cover no-repeat,
			#292725;
		box-shadow: var(--shadow);
	}

	.article-hero-copy {
		max-width: 50rem;
	}

	.article-hero h1 {
		margin: 0;
		max-width: 18ch;
		color: var(--yellow);
		font-size: clamp(2rem, 5.5vw, 4rem);
		line-height: 1.08;
		letter-spacing: -0.045em;
	}

	.article-hero-copy > p {
		max-width: 66ch;
		margin: 1.15rem 0 0;
		color: var(--normal);
		font-size: clamp(0.95rem, 2vw, 1.08rem);
		line-height: 1.7;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.25rem;
		margin-top: 1.25rem;
		color: var(--orange);
		font-size: 0.84rem;
	}

	.draft-badge {
		padding: 0.08rem 0.45rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--yellow);
	}

	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, var(--blog-reading-width)) minmax(12rem, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}

	.typeset-article {
		--typeset-font-body: 'JetBrains Mono', monospace;
		--typeset-font-heading: 'JetBrains Mono', monospace;
		--typeset-font-mono: 'JetBrains Mono', monospace;
		--typeset-size: 0.85rem;
		--typeset-leading: 1.82;
		--typeset-flow: 1.45em;
		--color-foreground: var(--normal);
		--color-muted-foreground: var(--blue);
		--color-border: var(--line);
		--color-ring: var(--yellow);
		--color-primary: var(--green);
		--color-muted: var(--paper-strong);
		--radius: 12px;
		min-width: 0;
	}

	.typeset-article :is(h2, h3) {
		letter-spacing: -0.025em;
	}

	.typeset-article :is(h2) {
		color: var(--yellow);
		padding: 2rem 0 1.5rem;
		font-size: 1.75em;
		line-height: 1.3;
	}

	.typeset-article :is(h3) {
		color: var(--brown);
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--line)
	}

	.typeset-article a {
		color: var(--green);
	}

	.typeset-article strong {
		font-weight: 800;
	}

	.typeset-article blockquote {
		color: var(--ink-soft);
		border-inline-start-color: var(--yellow);
	}

	.typeset-article .astro-code {
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		padding: 1.2rem 1.35rem;
	}

	.content-map-desktop {
		position: sticky;
		top: 1.5rem;
		max-height: calc(100vh - 3rem);
		overflow-y: auto;
		padding-right: 0.5rem;
		padding-left: 1rem;
		border-left: 1px solid var(--line);
	}

	.content-map-desktop > p,
	.content-map-mobile summary {
		margin: 0 0 0.8rem;
		color: var(--orange);
		font-size: 0.82rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.content-map ol,
	.content-map ul {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding-left: 1.5rem;
	}

	.content-map ul {
		gap: 0.25rem;
	}

	.content-map ol > li {
		color: var(--ink-soft);
	}

	.content-map ol > li::marker {
		font-size: 0.65rem;
		font-variant-numeric: tabular-nums;
	}

	.content-map ul {
		margin: 0.125rem 0;
		padding-left: 1.25rem;
		list-style-type: circle;
	}

	.content-map li.nested {
		color: var(--ink-normal);
	}

	.content-map li::marker {
		color: currentColor;
	}

	.content-map a {
		display: block;
		color: inherit;
		font-size: 0.78rem;
		line-height: 1.35;
		text-decoration: none;
		padding-bottom: 0.25rem;
	}

	.content-map li.active,
	.content-map li.active > a {
		color: var(--yellow);
	}

	.content-map-mobile {
		display: none;
	}

	.standalone-navigation {
		max-width: var(--blog-reading-width);
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}

	.standalone-navigation.top {
		padding-top: 0;
		border-top: 0;
	}

	.standalone-navigation a {
		display: inline-block;
		color: var(--yellow);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.series-navigation {
		max-width: var(--blog-reading-width);
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
	}


	.series-navigation.top {
		max-width: var(--blog-reading-width);
		margin-top: 0;
		border-top: 0;
	}

	.series-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		color: var(--ink-normal);
		font-size: 1.2rem;
		font-weight: 700;
		text-transform: uppercase;
		margin-bottom: 2rem;
	}

	.series-breadcrumb a {
		color: var(--yellow);
		text-decoration: none;
	}

	.series-breadcrumb a.series-title {
		color: var(--ink-normal);
	}

	.series-navigation > div {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.series-navigation > div > a {
		display: grid;
		gap: 0.35rem;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--paper-strong);
		text-decoration: none;
	}

	.series-navigation > div > a.next {
		text-align: right;
	}

	.series-navigation > div > a span {
		color: var(--orange);
		font-size: 0.75rem;
		text-transform: uppercase;
	}

	.series-navigation > div > a strong {
		color: var(--yellow);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	@media (max-width: 820px) {
		.article-layout {
			display: block;
		}

		.content-map-desktop {
			display: none;
		}

		.content-map-mobile {
			display: block;
			margin-top: 1.25rem;
			padding: 1rem;
			border: 1px solid var(--line);
			border-radius: 12px;
			background: var(--paper-strong);
		}

		.content-map-mobile summary {
			margin: 0;
			cursor: pointer;
		}

		.content-map-mobile[open] summary {
			margin-bottom: 0.9rem;
		}
	}

	@media (max-width: 560px) {
		.article-hero {
			min-height: 24rem;
			padding: 1.25rem;
		}

		.article-hero h1 {
			font-size: clamp(1.8rem, 10vw, 2.7rem);
		}

		.series-navigation > div {
			grid-template-columns: 1fr;
		}

		.series-navigation > div > span {
			display: none;
		}
	}
</style>
